# Copy to .env; values below suit the compose stack.
SECRET_KEY=change-me-to-a-long-random-string-of-50-characters
DEBUG=false
DATABASE_URL=postgres://drlibre:drlibre@localhost:5432/drlibre
REDIS_URL=redis://localhost:6379/0
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_TIME_ZONE=Europe/Paris
ALLOWED_HOSTS=["localhost","127.0.0.1"]
LOG_LEVEL=INFO
# true only behind TLS: HTTPS redirect, HSTS, secure cookies.
HTTPS_ONLY=false
# Absolute links in emails (sign-in links, confirmations).
PUBLIC_BASE_URL=http://localhost:8000
# Hourly cap per network address and kind of request (hold, code, link); raise it for load tests.
NETWORK_HOURLY_LIMIT=20
# Compose PostgreSQL credentials; DATABASE_URL above must match them.
POSTGRES_USER=drlibre
POSTGRES_PASSWORD=drlibre
POSTGRES_DB=drlibre
